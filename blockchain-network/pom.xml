<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.privatechain</groupId>
        <artifactId>private-blockchain</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>blockchain-network</artifactId>
    <name>blockchain-network</name>
    <description>
        Peer-to-peer networking module for the private-blockchain library.
        Provides TCP-based node server / client, gossip transaction propagation,
        block broadcasting, chain synchronization, and fork resolution.
        Depends on blockchain-core, blockchain-crypto, and blockchain-access.
    </description>

    <dependencies>

        <!-- Core domain model, SPI interfaces, event bus, and core.network interfaces -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Cryptographic utilities for peer key verification -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-crypto</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Access control — AllowlistManager and PermissionManager used in NodeServer (T-054).
            REQUIRED: without this dependency NodeServer cannot resolve AllowlistManager,
            PermissionManager, or NodeRole (errors seen in build log).
        -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-access</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Jackson: JSON message framing for the wire protocol -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            SpotBugs annotations (@SuppressFBWarnings).
            blockchain-core uses this annotation on Transaction and Blockchain classes.
            When javac compiles blockchain-network it reads those .class files and must
            be able to resolve the annotation type — otherwise -Werror turns the
            "Cannot find annotation method" warning into a build failure.
            Scope: provided — the JAR is only needed at compile time, not at runtime.
        -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- blockchain-consensus needed for ProofOfWorkEngine in integration tests -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-consensus</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- blockchain-storage: InMemoryStorage for integration tests -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-storage</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- SLF4J simple implementation for test log output -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Protobuf code generation (FR-NET-06) -->
            <plugin>
                <groupId>com.github.os72</groupId>
                <artifactId>protoc-jar-maven-plugin</artifactId>
                <version>3.11.4</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <protocVersion>4.28.2</protocVersion>
                            <inputDirectories>
                                <include>src/main/proto</include>
                            </inputDirectories>
                            <outputTargets>
                                <outputTarget>
                                    <type>java</type>
                                    <outputDirectory>
                                        ${project.build.directory}/generated-sources/protobuf/java
                                    </outputDirectory>
                                </outputTarget>
                            </outputTargets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: run JUnit 5 tests; allow loopback port binding -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <forkedProcessTimeoutInSeconds>60</forkedProcessTimeoutInSeconds>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
