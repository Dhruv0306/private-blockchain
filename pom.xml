    <!-- ─── Build plugins ─────────────────────────────────── -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- Compiler -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Unit tests -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                        <!--
                            M10 (T-078): PerformanceTest is tagged @Tag("performance").
                            Exclude on slow CI runners with:
                            mvn verify -DskipPerformanceTests=performance
                        -->
                        <excludedGroups>${skipPerformanceTests}</excludedGroups>
                    </configuration>
                </plugin>

                <!-- Integration tests -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Code coverage -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.80</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                                <!-- Only enforce on core and crypto modules -->
                                <excludes>
                                    <exclude>com/privatechain/network/**</exclude>
                                    <exclude>com/privatechain/examples/**</exclude>
                                </excludes>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- Code style -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle.version}</version>
                    <configuration>
                        <configLocation>google_checks.xml</configLocation>
                        <failsOnError>true</failsOnError>
                        <consoleOutput>true</consoleOutput>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- OWASP Dependency-Check — on-demand: mvn -Psecurity verify -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${owasp.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <suppressionFiles>
                            <suppressionFile>owasp-suppressions.xml</suppressionFile>
                        </suppressionFiles>
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <nvdApiKey>${nvdApiKey}</nvdApiKey>
                        <nvdApiDelay>2000</nvdApiDelay>
                        <skipTestScope>false</skipTestScope>
                        <skipProvidedScope>false</skipProvidedScope>
                    </configuration>
                </plugin>

                <!-- ═══════════════════════════════════════════════════════════
                     Javadoc — M10 (T-076, T-081)
                     Per-module: doclint=all enforces strict documentation on
                     every module's own classes during mvn verify.
                     Aggregate: doclint=none used for the aggregate site report
                     so that unresolvable cross-module @link references to do not
                     break the aggregate build.
                     ═══════════════════════════════════════════════════════════ -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.7.0</version>
                    <configuration>
                        <!-- Per-module: strict (enforces NFR-UX-01) -->
                        <doclint>all,-missing</doclint>
                        <quiet>true</quiet>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <!-- Exclude example packages from doclint enforcement;
                             they are not part of the published public API -->
                        <excludePackageNames>com.privatechain.examples</excludePackageNames>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Sources jar — required alongside Javadoc jar for publishing -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- GPG signing — activated by the release profile -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${gpg.plugin.version}</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- SpotBugs (FindBugs successor) -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.8.3.1</version>
                    <configuration>
                        <effort>max</effort>
                        <threshold>medium</threshold>
                        <failOnError>true</failOnError>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>1.12.0</version>
                            </plugin>
                        </plugins>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotbugs</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- ═══════════════════════════════════════════════════════════
                     Maven Release Plugin — M10 (T-080)
                     Manages the version bump, SCM tag, and deploy to
                     GitHub Packages in a single atomic operation.

                     Usage:
                       mvn release:prepare -Prelease   # bumps version, commits, tags
                       mvn release:perform -Prelease   # checks out tag, builds, deploys
                     ═══════════════════════════════════════════════════════════ -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.1.1</version>
                    <configuration>
                        <!-- Tag format: v1.0.0, v1.0.1, ... -->
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <!-- All child modules automatically get the same version -->
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <!-- Commit message prefix (avoids re-triggering javadoc.yml) -->
                        <scmCommentPrefix>[release]</scmCommentPrefix>
                        <!-- Full build + test run before tagging (no shortcuts) -->
                        <preparationGoals>clean verify</preparationGoals>
                        <completionGoals>clean install</completionGoals>
                        <!-- Push the release commit and tag to the remote immediately -->
                        <pushChanges>true</pushChanges>
                        <!-- Check out from local clone (faster in CI) -->
                        <localCheckout>true</localCheckout>
                        <!-- Activate the release profile during perform so sources/javadoc
                             JARs are attached before deploy -->
                        <releaseProfiles>release</releaseProfiles>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>

        <!-- Active for every module -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- ═══════════════════════════════════════════════════════════
         Reporting — M10 (T-081)
         mvn javadoc:aggregate -pl . generates the aggregate Javadoc
         site under target/site/apidocs/. The javadoc.yml workflow
         picks up that directory and publishes it to GitHub Pages.

         doclint:none here (aggregate only) — strict doclint enforcement
         is in the per-module pluginManagement configuration above.
         The aggregate report uses "none" because cross-module @link
         resolution may produce spurious doclint warnings for classes
         whose JARs are not on the javadoc tool's classpath at aggregate time.
    ═══════════════════════════════════════════════════════════ -->
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.7.0</version>
                <inherited>false</inherited>
                <reportSets>
                    <reportSet>
                        <id>aggregate</id>
                        <inherited>false</inherited>
                        <reports>
                            <report>aggregate</report>
                        </reports>
                    </reportSet>
                </reportSets>
                <configuration>
                    <!-- Relaxed for aggregate — avoids cross-module false positives -->
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <detectJavaApiLink>false</detectJavaApiLink>
                    <!-- Exclude example package from aggregate API docs -->
                    <excludePackageNames>com.privatechain.examples</excludePackageNames>
                </configuration>
            </plugin>
        </plugins>
    </reporting>

    <!-- ─── Profiles ──────────────────────────────────────── -->
    <profiles>

        <!-- ═══════════════════════════════════════════════════════════
             Release profile — M10 (T-080)
             Activated automatically by maven-release-plugin via
             <releaseProfiles>release</releaseProfiles> in the plugin config
             above, and manually with -Prelease.

             Attaches:
               - sources JAR  (maven-source-plugin)
               - Javadoc JAR  (maven-javadoc-plugin, doclint=none for the jar)
               - GPG signature (maven-gpg-plugin)

             The GPG plugin requires:
               - GPG_PRIVATE_KEY   secret in GitHub Actions (armored private key)
               - GPG_PASSPHRASE    secret in GitHub Actions
             These are configured in release.yml and loaded into the Maven
             settings.xml by actions/setup-java.

             For GitHub Packages (no GPG requirement):
             Comment out the maven-gpg-plugin block below.
             GitHub Packages authenticates via GITHUB_TOKEN, not GPG.
        ═══════════════════════════════════════════════════════════ -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <!-- Relaxed doclint for the -javadoc.jar artifact so the
                                 release build does not fail on example package warnings -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                    </plugin>
                    <!-- Uncomment when publishing to Maven Central (requires GPG key).
                         GitHub Packages does not need GPG signing.
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    -->
                </plugins>
            </build>
        </profile>

        <!-- ═══════════════════════════════════════════════════════════
             Security scan profile — run on demand: mvn -Psecurity verify
        ═══════════════════════════════════════════════════════════ -->
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <executions>
                            <execution>
                                <id>owasp-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

    <!-- ─── Distribution management — M10 (T-080) ────────────
         Updated from OSSRH (Maven Central staging) to GitHub Packages.
         The server id "github" must match the server configured by
         actions/setup-java in release.yml (server-id: github).

         Authentication:
           CI:    GITHUB_TOKEN secret (automatic; no additional setup)
           Local: add a <server> entry to ~/.m2/settings.xml:
             <server>
               <id>github</id>
               <username>${env.GITHUB_ACTOR}</username>
               <password>${env.GITHUB_TOKEN}</password>
             </server>
    ──────────────────────────────────────────────────────── -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — private-blockchain releases</name>
            <url>https://maven.pkg.github.com/dhruv0306/private-blockchain</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages — private-blockchain snapshots</name>
            <url>https://maven.pkg.github.com/dhruv0306/private-blockchain</url>
        </snapshotRepository>
    </distributionManagement>

</project>
