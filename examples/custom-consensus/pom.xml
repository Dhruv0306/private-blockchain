<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.privatechain</groupId>
        <artifactId>private-blockchain</artifactId>
        <version>1.0.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>example-custom-consensus</artifactId>
    <packaging>jar</packaging>
    <name>Example: Custom Consensus Engine</name>
    <description>
        Demonstrates implementing the ConsensusEngine SPI. Provides a
        VotingConsensusEngine where block acceptance requires signed approval
        votes from a majority of registered validators — a complete, runnable
        example of the library's extension model.
    </description>

    <dependencies>
        <!-- Core library — data model and SPI interfaces -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-core</artifactId>
        </dependency>

        <!-- Cryptographic primitives -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-crypto</artifactId>
        </dependency>

        <!--
             Consensus module — needed for ConsensusSupport.buildBlock() and
             ConsensusSupport.isGenesis() used inside VotingConsensusEngine.
             Added in M10 (T-074): VotingConsensusEngine delegates block assembly
             to the shared ConsensusSupport utility rather than duplicating the logic.
        -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-consensus</artifactId>
        </dependency>

        <!-- Storage implementations — InMemoryStorage used in VotingConsensusDemo -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-storage</artifactId>
        </dependency>

        <!-- SLF4J / Logback for readable demo output -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.8.3</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.privatechain.examples.VotingConsensusDemo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
