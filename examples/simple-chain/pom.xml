<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.privatechain</groupId>
        <artifactId>private-blockchain</artifactId>
        <version>1.0.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>example-simple-chain</artifactId>
    <packaging>jar</packaging>
    <name>Example: Simple Chain</name>
    <description>
        Minimal standalone example. Creates a BlockchainNode with PoW, defines a
        MoneyTransferTransaction subclass, submits transactions, mines a block, and
        validates the chain. Run with: mvn exec:java
    </description>

    <dependencies>
        <!-- Core library — data model and SPI interfaces -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-core</artifactId>
        </dependency>

        <!-- Cryptographic primitives (used by WalletManager internally) -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-crypto</artifactId>
        </dependency>

        <!-- Consensus engines — ProofOfWorkEngine used in the demo -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-consensus</artifactId>
        </dependency>

        <!-- Storage implementations — InMemoryStorage and ChainExporter used in the demo -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-storage</artifactId>
        </dependency>

        <!--
             Wallet and key management — WalletManager and Wallet used in the demo.
             Added in M10 (T-074): the demo requires wallet signing to illustrate
             the full transaction lifecycle including ECDSA signatures.
        -->
        <dependency>
            <groupId>com.privatechain</groupId>
            <artifactId>blockchain-wallet</artifactId>
        </dependency>

        <!-- SLF4J / Logback for readable demo output -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.8.3</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.privatechain.examples.SimpleChainDemo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
