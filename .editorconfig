# EditorConfig helps maintain consistent coding styles across editors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{yml,yaml,xml,properties,proto}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false